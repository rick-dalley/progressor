# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# User Data & Assets
# ------------------
# Ignore all common image/video formats
*.jpg
*.jpeg
*.png
*.gif
*.webp
*.heic
*.heif
*.pdf
*.mp4
*.mov

# Ignore local assets folder if used for temp storage
/assets/screen_captures/
/assets/interactions/

# ...but generated platform icons are not disposable user data — the blanket
# *.png rule above would otherwise silently leave them untracked, breaking
# the build for anyone else who clones this repo.
!ios/Runner/Assets.xcassets/**/*.png
!android/app/src/main/res/mipmap-*/*.png
!macos/Runner/Assets.xcassets/**/*.png
!web/icons/*.png
!web/favicon.png
# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
